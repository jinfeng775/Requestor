{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./out",
    "types": ["electron-vite/node"]
  },
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "src/renderer/src/types/ipc.ts",
    "src/renderer/src/types/request.ts",
    "src/renderer/src/types/realtime.ts"
  ]
}
